[Unit]
Description=ipoed
Before=network.target
Wants=network.target

[Service]
EnvironmentFile=-/etc/default/ipoed
Type=simple
ExecStartPre=/usr/libexec/ipoed/ipoed_start_pre
ExecStart=/usr/sbin/ipoed --wan-if $WAN_IF --lan-if $LAN_IF $IPOED_OPTS
ExecStopPost=/usr/libexec/ipoed/ipoed_stop_post

[Install]
WantedBy=network.target
Alias=ipoed.service
